<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Display area at top -->
    <TextView
        android:id="@+id/calc_display"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:minHeight="72dp"
        android:gravity="end|center_vertical"
        android:text="0"
        android:textColor="#212121"
        android:textSize="36sp"
        android:background="@android:color/transparent"
        android:padding="22dp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/keypad_grid"
        app:layout_constraintHeight_percent="0.25"/>

    <!-- Calculator keypad grid below -->
    <GridLayout
        android:id="@+id/keypad_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:alignmentMode="alignMargins"
        android:columnCount="4"
        android:rowCount="5"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calc_display"
        app:layout_constraintHeight_percent="0.75">

        <!-- Row 1: Clear, Back, Divide, Multiply -->
        <Button
            android:id="@+id/btn_clear"
            style="@style/CalcKeySecondary"
            android:text="C"
            android:layout_row="0"
            android:layout_column="0"/>
        <Button
            android:id="@+id/btn_back"
            style="@style/CalcKeySecondary"
            android:text="⌫"
            android:layout_row="0"
            android:layout_column="1"/>
        <Button
            android:id="@+id/btn_divide"
            style="@style/CalcKey"
            android:text="÷"
            android:layout_row="0"
            android:layout_column="2"/>
        <Button
            android:id="@+id/btn_multiply"
            style="@style/CalcKey"
            android:text="×"
            android:layout_row="0"
            android:layout_column="3"/>

        <!-- Row 2: 7 8 9 - -->
        <Button
            android:id="@+id/btn_7"
            style="@style/CalcKey"
            android:text="7"
            android:layout_row="1"
            android:layout_column="0"/>
        <Button
            android:id="@+id/btn_8"
            style="@style/CalcKey"
            android:text="8"
            android:layout_row="1"
            android:layout_column="1"/>
        <Button
            android:id="@+id/btn_9"
            style="@style/CalcKey"
            android:text="9"
            android:layout_row="1"
            android:layout_column="2"/>
        <Button
            android:id="@+id/btn_subtract"
            style="@style/CalcKey"
            android:text="-"
            android:layout_row="1"
            android:layout_column="3"/>

        <!-- Row 3: 4 5 6 + -->
        <Button
            android:id="@+id/btn_4"
            style="@style/CalcKey"
            android:text="4"
            android:layout_row="2"
            android:layout_column="0"/>
        <Button
            android:id="@+id/btn_5"
            style="@style/CalcKey"
            android:text="5"
            android:layout_row="2"
            android:layout_column="1"/>
        <Button
            android:id="@+id/btn_6"
            style="@style/CalcKey"
            android:text="6"
            android:layout_row="2"
            android:layout_column="2"/>
        <Button
            android:id="@+id/btn_add"
            style="@style/CalcKey"
            android:text="+"
            android:layout_row="2"
            android:layout_column="3"/>

        <!-- Row 4: 1 2 3 = -->
        <Button
            android:id="@+id/btn_1"
            style="@style/CalcKey"
            android:text="1"
            android:layout_row="3"
            android:layout_column="0"/>
        <Button
            android:id="@+id/btn_2"
            style="@style/CalcKey"
            android:text="2"
            android:layout_row="3"
            android:layout_column="1"/>
        <Button
            android:id="@+id/btn_3"
            style="@style/CalcKey"
            android:text="3"
            android:layout_row="3"
            android:layout_column="2"/>
        <Button
            android:id="@+id/btn_equals"
            style="@style/CalcKeyAccent"
            android:text="="
            android:layout_row="3"
            android:layout_column="3"
            android:layout_rowSpan="2"
            android:minHeight="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            />

        <!-- Row 5: 0 . -->
        <Button
            android:id="@+id/btn_0"
            style="@style/CalcKey"
            android:text="0"
            android:layout_row="4"
            android:layout_column="0"
            android:layout_columnSpan="2"/>
        <Button
            android:id="@+id/btn_dot"
            style="@style/CalcKey"
            android:text="."
            android:layout_row="4"
            android:layout_column="2"/>

        <!-- The equals button fills the last cell in row 4 (rowSpan=2 above) -->
    </GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
