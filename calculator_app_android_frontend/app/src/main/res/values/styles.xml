<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Basic app theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#1976D2</item>
        <item name="colorPrimaryDark">#1976D2</item>
        <item name="colorAccent">#FFB300</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:buttonStyle">@style/CalcKey</item>
        <item name="android:textColorPrimary">#212121</item>
    </style>

    <!-- Keypad button style -->
    <style name="CalcKey" parent="Widget.AppCompat.Button">
        <item name="android:background">#FAFAFA</item>
        <item name="android:textColor">#1976D2</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:minHeight">56dp</item>
    </style>
    <!-- Secondary key (clear/back) style -->
    <style name="CalcKeySecondary" parent="CalcKey">
        <item name="android:background">#E3E9F7</item>
        <item name="android:textColor">#616161</item>
    </style>
    <!-- Accent key (=) style -->
    <style name="CalcKeyAccent" parent="CalcKey">
        <item name="android:background">#FFB300</item>
        <item name="android:textColor">#fff</item>
    </style>
</resources>
